# ---------------------------------------------------------------------------
# Required secrets — app refuses to start without these
# ---------------------------------------------------------------------------

# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Fernet symmetric key for encrypting per-user GIS auth passwords at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this value will make existing user records un-decryptable.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Shared ArcGIS editor credentials (used for the step-3 upload token).
# All users upload through this single editor account; per-user identity is
# preserved via their own GIS_AUTH credentials at step-1.
# Required for any /api/kml or /api/arcgis route — server boots without them
# (so /api/health and /docs work), but calls will 503.
# ---------------------------------------------------------------------------
GIS_USERNAME=
GIS_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase — provide ONE of the following
# ---------------------------------------------------------------------------
# Local dev: path to a service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Production (Render/Railway/etc.): paste the service-account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# ---------------------------------------------------------------------------
# ArcGIS endpoint configuration (override only if pointing at a different env)
# ---------------------------------------------------------------------------


# Token cache TTL in seconds (default 3000 — tokens expire after 60 minutes).
# ARCGIS_TOKEN_TTL_SECONDS=3000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. The Vue frontend dev server defaults to :5173;
# the production Vercel deployment is flight-zone-exporter-vue.vercel.app.
# Use "*" only for trusted environments (credentials are auto-disabled with wildcard).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# File processing
# ---------------------------------------------------------------------------
# WORK_DIR=working
